{
  "version": 1,
  "sdk_version": "3.1.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://wuxptfqxiymierorbfzz.supabase.co/auth/v1",
    "resource": "https://beta.raidfi.site/mcp",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "raidfi",
      "version": "0.3.0",
      "title": "RaidFi"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my RaidFi profile",
        "description": "Return the signed-in contributor's RaidFi profile: name, X handle, verification, XP and referral code.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_my_contributions",
        "title": "List my contributions",
        "description": "List the signed-in contributor's tracked X posts with status, score and XP earned.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "status": {
              "description": "Only return posts with this status.",
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "rejected"
              ]
            },
            "limit": {
              "default": 20,
              "description": "Maximum posts to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_leaderboard",
        "title": "Get leaderboard",
        "description": "Return the RaidFi contributor leaderboard for a period.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "period": {
              "default": "all",
              "description": "Time period.",
              "type": "string",
              "enum": [
                "all",
                "day",
                "week",
                "month"
              ]
            },
            "limit": {
              "default": 25,
              "description": "Number of entries.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "submit_contribution",
        "title": "Submit an X post",
        "description": "Submit one of your X posts to RaidFi for review, optionally for a specific project (by slug).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "post_url": {
              "type": "string",
              "pattern": "^https:\\/\\/(x|twitter)\\.com\\/[^/]+\\/status\\/\\d+"
            },
            "project_slug": {
              "type": "string",
              "maxLength": 100
            }
          },
          "required": [
            "post_url"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "analyze_my_performance",
        "title": "Analyze my performance",
        "description": "Summarize your contribution history: acceptance rate, average score, best content types, recent rejection notes and concrete tips to improve your reputation.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_project_analytics",
        "title": "Project analytics",
        "description": "30-day contribution analytics for a project: submissions, accepted, unique contributors, XP awarded, acceptance rate and pending queue size. Needs a full-access project key.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "api_key": {
              "type": "string",
              "pattern": "^rf_live_",
              "description": "Your project's RaidFi API key (rf_live_...), from Project Settings → Developer API."
            }
          },
          "required": [
            "api_key"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_project_contributions",
        "title": "List project contributions",
        "description": "List a project's submissions with post text, author, status, scores and review notes. Use status=pending to get the review queue.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "api_key": {
              "type": "string",
              "pattern": "^rf_live_",
              "description": "Your project's RaidFi API key (rf_live_...), from Project Settings → Developer API."
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "rejected"
              ]
            },
            "limit": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "required": [
            "api_key"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "review_contribution",
        "title": "Approve or reject a contribution",
        "description": "Approve or reject one of your project's submissions, optionally setting XP, a 0-100 quality score and a note the contributor will see explaining the decision. Lets an AI agent review submissions automatically.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "api_key": {
              "type": "string",
              "pattern": "^rf_live_",
              "description": "Your project's RaidFi API key (rf_live_...), from Project Settings → Developer API."
            },
            "contribution_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "decision": {
              "type": "string",
              "enum": [
                "approved",
                "rejected"
              ]
            },
            "points": {
              "description": "XP to award when approving.",
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "score": {
              "description": "Quality score 0-100.",
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "notes": {
              "description": "Feedback for the contributor, e.g. why it was rejected.",
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": [
            "api_key",
            "contribution_id",
            "decision"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_contributor_reputation",
        "title": "Contributor reputation",
        "description": "Look up a contributor's RaidFi reputation (0-1000 score, tier, XP, acceptance rate, verified X) by X handle or email. Works with any project key.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "api_key": {
              "type": "string",
              "pattern": "^rf_live_",
              "description": "Your project's RaidFi API key (rf_live_...), from Project Settings → Developer API."
            },
            "identifier": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "X handle or email."
            }
          },
          "required": [
            "api_key",
            "identifier"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_docs",
        "title": "List docs",
        "description": "List every RaidFi documentation page (slug, section, title, summary).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "read_doc",
        "title": "Read doc",
        "description": "Read one RaidFi documentation page as Markdown, including the live whitepaper (slug 'whitepaper').",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Doc slug from list_docs."
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
